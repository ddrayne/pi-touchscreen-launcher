{
  "name": "pi-touchscreen-launcher",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "appliance:dev": "vite --config appliance/vite.config.ts",
    "appliance:build": "vite build --config appliance/vite.config.ts",
    "test": "npm run build && node --test tests/*.test.mjs && python3 -m unittest discover -s bridge -p 'test_*.py'",
    "test:bridge": "python3 -m py_compile bridge/launcher_bridge.py bridge/launcher_watchdog.py bridge/portrait_features.py bridge/wake_listener.py && python3 -m unittest discover -s bridge -p 'test_*.py'",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern dist-appliance --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "frame:mock": "node scripts/mock-bridge.mjs",
    "frame:shots": "node scripts/screenshot-frame.mjs",
    "test:frame": "node --test tests/frame-*.test.mjs",
    "typecheck:frame": "NODE_OPTIONS=--max-old-space-size=6144 tsc -p tsconfig.frame.json"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "playwright": "^1.56.1",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
